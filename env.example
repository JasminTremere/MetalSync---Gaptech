# ============================================================
# MetalSync – GAPTECH USINAGEM E FERRAMENTARIA LTDA
# Módulo 2 – Infraestrutura e Mocks
# ============================================================

# --- Serviços ---
SERVICO_PEDIDO_PORT=8001
SERVICO_PAGAMENTO_PORT=8002
SERVICO_LOGISTICA_PORT=8003

# --- Dashboard ---
DASHBOARD_PORT=8050

# --- RabbitMQ (Broker) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# --- MySQL Remoto – HostGator (Plano M) ---
DB_HOST=seu-host.hostgator.com.br
DB_USER=gaptech_user
DB_PASS=sua_senha_segura
DB_NAME=gaptech_metalsync

# --- Comportamento dos Mocks ---
TAXA_ANTIFRAUDE=1          # eventos por segundo
PROB_APROVACAO_FRAUDE=0.90 # 90% aprovado, 10% bloqueado

# --- Ambiente ---
ENV=development
LOG_LEVEL=INFO
