# Broker
BROKER_HOST=rabbitmq
BROKER_PORT=5672

# Banco de Dados MySQL (HostGator - Compartilhado logicamente para economizar recursos)
DB_HOST=seu_servidor_mysql.hostgator.com.br
DB_USER=seu_usuario_cpanel
DB_PASS=sua_senha_cpanel
DB_NAME=seu_banco_metalsync

# Portas dos serviços
PEDIDO_PORT=8001
PAGAMENTO_PORT=8002
LOGISTICA_PORT=8003
DASHBOARD_PORT=8050

# Taxa dos mocks (eventos por segundo)
TAXA_ANTIFRAUDE=1
TAXA_CATALOGO=1